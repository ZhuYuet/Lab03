   50:		N      0040	EXPR_BUF      EQU 40H            ; 18-byte complete logical expression
   51:		N      0052	EXPR_LEN      EQU 52H
   52:		N      0053	EXPR_VIEW     EQU 53H            ; First character shown on LCD line 1
   53:		N      0054	LAST_CHAR_LEN EQU 54H        ; Tracks width of last printed symbol (1 or 2)
   54:		N      0055	MODE_SCROLL_OFFSET EQU 55H   ; 0-15 start position in repeated mode title
   55:		N      0056	INPUT_CURSOR_ADDR EQU 56H    ; Restore line-1 cursor after line-2 animation
   56:		N      0057	CREDIT_SCROLL_OFFSET EQU 57H ; 0-15 start position in repeated developer name
   57:		N      0058	CREDIT_NAME_INDEX EQU 58H    ; Developer name 0-3
   58:		N      0059	CREDIT_FRAME_COUNT EQU 59H   ; Frames remaining before advancing the name
   59:		N      0012	EXPR_MAX      EQU 12H            ; 8 bits + operator + 8 bits + equals
   60:		N      0080	LCD_LINE1     EQU 080H
   61:		N      00C0	LCD_LINE2     EQU 0C0H
   62:		N      0010	LCD_WIDTH     EQU 10H
   63:				; 20H.0 = received decimal result is negative
   64:				; 20H.1 = last expression character is a replaceable binary operator
   65:				; 20H.2 = abort credits delay flag
   66:				; 20H.3 = equation cursor should be visible after a mode-title redraw
   67:				; 20H.4 = mode-title marquee is active
   68:
