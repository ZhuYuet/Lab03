 Line  I  Addr  Code            Source

    1:				; 8051 CALCULATOR V3 - PROCESS CONTROLLER, UART TWO-WIRE LINK
    2:				; Controller 1 owns the 4x4 keypad, input validation, calculator state,
    3:				; ALU operations, and error detection.  It does not drive the LCD.
    4:
    5:				; ==============================
    6:				; 		DECLARATIONS & EQU
    7:				; ==============================
    8:		N      00C0	EV_OP_ADD      EQU 0C0H
    9:		N      00C1	EV_OP_SUB      EQU 0C1H
   10:		N      00C2	EV_OP_MUL      EQU 0C2H
   11:		N      00C3	EV_OP_DIV      EQU 0C3H
   12:		N      00C4	EV_OP_AND      EQU 0C4H
   13:		N      00C5	EV_OP_OR       EQU 0C5H
   14:		N      00C6	EV_OP_XOR      EQU 0C6H
   15:		N      00C7	EV_OP_NOT      EQU 0C7H
   16:		N      00C8	EV_OP_SQUARE   EQU 0C8H
   17:		N      00C9	EV_OP_POWER    EQU 0C9H
   18:		N      00CA	EV_OP_SQRT     EQU 0CAH
   19:		N      00CB	EV_CREDITS     EQU 0CBH         ; NEW: Credits screen trigger
   20:		N      00BF	EV_OP_BASE     EQU 0BFH
   21:		N      00D0	EV_RESULT_DEC  EQU 0D0H
   22:		N      00D1	EV_RESULT_BIN  EQU 0D1H
   23:		N      00D2	EV_ERROR       EQU 0D2H
   24:		N      00D3	EV_RESULT_FRAC EQU 0D3H
   25:		N      00E0	EV_STARTUP     EQU 0E0H
   26:		N      00E1	EV_MODE_AR     EQU 0E1H
   27:		N      00E2	EV_MODE_LOG    EQU 0E2H
   28:		N      00E3	EV_MODE_ADV    EQU 0E3H
   29:		N      00E4	EV_CLEAR       EQU 0E4H
   30:		N      00E5	EV_MENU        EQU 0E5H
   31:		N      00E6	EV_ANS         EQU 0E6H
   32:		N      00E7	EV_EQUALS      EQU 0E7H
   33:		N      00E8	EV_SCROLL_LEFT EQU 0E8H
   34:		N      00E9	EV_SCROLL_RIGHT EQU 0E9H
   35:		N      00EA	EV_BACKSPACE	EQU 0EAH
   36:
   37:				; ==============================
   38:				; 		RAM ALLOCATIONS
   39:				; ==============================
   40:		N      0030	DIGIT_TMP   EQU 30H
   41:		N      0031	TMP_H       EQU 31H
   42:		N      0032	TMP_L       EQU 32H
   43:		N      0033	QUO_H       EQU 33H

