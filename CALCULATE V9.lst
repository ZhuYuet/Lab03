 1148:	  069E	9C		    SUBB A, R4                  ; High byte subtract with carry
 1149:	  069F	40 0C		    JC SQRT_OVERSHOOT           ; Borrow set -> Square > Target
 1150:	  06A1	E5 48			MOV A, 48H
 1151:	  06A3	6C		    XRL A, R4
 1152:	  06A4	70 EA		    JNZ SQRT_LOOP               ; High byte > 0 -> Target > Square, continue
 1153:	  06A6	E5 49			MOV A, 49H
 1154:	  06A8	6D		    XRL A, R5
 1155:	  06A9	70 E5		    JNZ SQRT_LOOP
 1156:	  06AB	80 08		    SJMP SQRT_EXACT             ; Perfect match!
 1157:
 1158:	  06AD			SQRT_OVERSHOOT:
 1159:	  06AD	18		    DEC R0                      ; Step back to largest integer root
 1160:	  06AE	7A 00			MOV R2, #00H
 1161:	  06B0	E8			MOV A, R0
 1162:	  06B1	FB		    MOV R3, A
 1163:	  06B2	C2 02		    CLR 20H.2

