   95:	  001E	30 A0 09	    JNB P2.0, DO_BACKSPACE
   96:	  0021	12 04 11		LCALL KEYPAD_SCAN
   97:	  0024	B4 FF 1C	    CJNE A, #0FFH, PROCESS_KEY
   98:	  0027	02 00 1B	    LJMP CALC_LOOP
   99:

