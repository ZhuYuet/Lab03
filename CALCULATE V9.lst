   63:
   64:				; R2:R3 = operand 1/result, R4:R5 = operand 2
   65:				; R6 = operator, R7 = 0 operand 1 / 1 operand 2 / 2 unary locked
   66:				; 20H.0 error, 20H.1 star pending, 20H.2 negative magnitude
   67:				; 20H.3 result displayed, 20H.4 current operand has an accepted digit
   68:
   69:				; ==============================
   70:				; 	MAIN LOOP & KEY DISPATCHER
   71:				; ==============================
   72:		N      0000	    ORG 0000H
   73:	  0000	02 00 03	    LJMP MAIN
   74:
