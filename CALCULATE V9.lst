 1226:	  0720	A4		    MUL AB                      ; B = High byte, A = Low byte
 1227:	  0721	AC F0		    MOV R4, B                   ; R4 = Square High
 1228:	  0723	FD		    MOV R5, A                   ; R5 = Square Low
 1229:
 1230:				    ; 16-bit subtraction: Target (48H:49H) - Square (R4:R5)
 1231:	  0724	C3		    CLR C
 1232:	  0725	E5 49		    MOV A, 49H
