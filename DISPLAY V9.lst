 Line  I  Addr  Code            Source

   44:		N      0036	QUO_H         EQU 36H
   45:		N      0037	QUO_L         EQU 37H
   46:		N      0038	REM_L         EQU 38H
   47:		N      0039	DIGIT_COUNT   EQU 39H
   48:		N      003A	BIT_TEMP      EQU 3AH
   49:		N      003B	RESULT_REM_H  EQU 3BH
   50:		N      003C	RESULT_REM_L  EQU 3CH
   51:		N      003F	TOTAL_WIDTH   EQU 3FH
   52:		N      0040	EXPR_BUF      EQU 40H            ; 18-byte complete logical expression
   53:		N      0052	EXPR_LEN      EQU 52H
   54:		N      0053	EXPR_VIEW     EQU 53H            ; First character shown on LCD line 1
   55:		N      0054	LAST_CHAR_LEN EQU 54H        ; Tracks width of last printed symbol (1 or 2)
   56:		N      0055	MODE_SCROLL_OFFSET EQU 55H   ; 0-15 start position in repeated mode title
   57:		N      0056	INPUT_CURSOR_ADDR EQU 56H    ; Restore line-1 cursor after line-2 animation
   58:		N      0057	CREDIT_SCROLL_OFFSET EQU 57H ; 0-15 start position in repeated developer name
   59:		N      0058	CREDIT_NAME_INDEX EQU 58H    ; Developer name 0-3
   60:		N      0059	CREDIT_FRAME_COUNT EQU 59H   ; Frames remaining before advancing the name
   61:		N      0012	EXPR_MAX      EQU 12H            ; 8 bits + operator + 8 bits + equals
   62:		N      0080	LCD_LINE1     EQU 080H
   63:		N      00C0	LCD_LINE2     EQU 0C0H
   64:		N      0010	LCD_WIDTH     EQU 10H
   65:				; 20H.0 = received decimal result is negative
   66:				; 20H.1 = last expression character is a replaceable binary operator
   67:				; 20H.2 = abort credits delay flag
   68:				; 20H.3 = equation cursor should be visible after a mode-title redraw
   69:				; 20H.4 = mode-title marquee is active
   70:				; 20H.5 = line 1 begins with the complete ANS token
   71:				; 20H.6 = ignore backspace after '=' until a new entry begins
   72:
