   67:
   68:				; R2:R3 = operand 1/result, R4:R5 = operand 2
   69:				; R6 = operator, R7 = 0 operand 1 / 1 operand 2 / 2 unary locked
   70:				; 20H.0 error, 20H.1 star pending, 20H.2 negative magnitude
   71:				; 20H.3 equals/result lock, 20H.4 current operand has an accepted digit
   72:				; 20H.5 operand 1 is the complete ANS token
   73:				; 20H.6 dedicated backspace lock after '='
   74:				; 20H.7 software power-off state
   75:
   76:				; ==============================
   77:				; 	MAIN LOOP & KEY DISPATCHER
   78:				; ==============================
   79:		N      0000	    ORG 0000H
   80:	  0000	02 00 03	    LJMP MAIN
   81:
   82:	  0003			MAIN:
   83:	  0003	75 81 5F	    MOV SP, #5FH
   84:	  0006	75 90 FF	    MOV P1, #0FFH
   85:	  0009	75 A0 FF	    MOV P2, #0FFH
   86:	  000C	D2 B0		    SETB P3.0
   87:	  000E	D2 B1		    SETB P3.1
   88:	  0010	12 03 8E	    LCALL UART_INIT
   89:	  0013	75 44 00	    MOV MODE, #00H
   90:	  0016	12 02 E2	    LCALL RESET_STATE
   91:	  0019	D2 07		    SETB 20H.7                 ; Start off; DEL performs the first power-on
   92:
