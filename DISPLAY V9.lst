 Line  I  Addr  Code            Source

    1:				; 8051 CALCULATOR V3 - DISPLAY CONTROLLER, UART TWO-WIRE LINK
    2:				; Controller 2 owns the 16x2 LCD and all presentation formatting.
    3:				; Receives semantic events and result/error data from process controller.
    4:
    5:		N      00C0	EV_OP_ADD      EQU 0C0H
    6:		N      00C1	EV_OP_SUB      EQU 0C1H
    7:		N      00C2	EV_OP_MUL      EQU 0C2H
    8:		N      00C3	EV_OP_DIV      EQU 0C3H
    9:		N      00C4	EV_OP_AND      EQU 0C4H
   10:		N      00C5	EV_OP_OR       EQU 0C5H
   11:		N      00C6	EV_OP_XOR      EQU 0C6H
   12:		N      00C7	EV_OP_NOT      EQU 0C7H
   13:		N      00C8	EV_OP_SQUARE   EQU 0C8H
   14:		N      00C9	EV_OP_POWER    EQU 0C9H
   15:		N      00CA	EV_OP_SQRT     EQU 0CAH
   16:		N      00CB	EV_CREDITS     EQU 0CBH         ; NEW: Credits screen trigger
   17:
   18:		N      00D0	EV_RESULT_DEC  EQU 0D0H
   19:		N      00D1	EV_RESULT_BIN  EQU 0D1H
   20:		N      00D2	EV_ERROR       EQU 0D2H
   21:		N      00D3	EV_RESULT_REM  EQU 0D3H          ; Quotient and remainder result
   22:		N      00E0	EV_STARTUP     EQU 0E0H
   23:		N      00E1	EV_MODE_AR     EQU 0E1H
   24:		N      00E2	EV_MODE_LOG    EQU 0E2H
   25:		N      00E3	EV_MODE_ADV    EQU 0E3H
   26:		N      00E4	EV_CLEAR       EQU 0E4H
   27:		N      00E5	EV_MENU        EQU 0E5H
   28:		N      00E6	EV_ANS         EQU 0E6H
   29:		N      00E7	EV_EQUALS      EQU 0E7H
   30:		N      00E8	EV_SCROLL_LEFT EQU 0E8H
   31:		N      00E9	EV_SCROLL_RIGHT EQU 0E9H
   32:		N      00EA	EV_BACKSPACE	EQU 0EAH
   33:		N      00EB	EV_BACKSPACE_ANS EQU 0EBH       ; Delete the complete ANS token
   34:		N      00EC	EV_POWER_OFF    EQU 0ECH        ; Turn LCD off in the mode menu
   35:		N      00ED	EV_BS_SHOW_OP   EQU 0EDH        ; Backspace exposed an operator
   36:		N      00EE	EV_BS_REMOVE_OP EQU 0EEH        ; Backspace removed an operator
   37:
   38:		N      0030	RX_BYTE       EQU 30H
   39:		N      0031	DISPLAY_MODE  EQU 31H           ; 0 menu, 1 arithmetic, 2 logical, 3 additional
   40:		N      0032	RESULT_H      EQU 32H
   41:		N      0033	RESULT_L      EQU 33H
   42:		N      0034	TMP_H         EQU 34H
   43:		N      0035	TMP_L         EQU 35H

